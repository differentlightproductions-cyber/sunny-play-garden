<?xml version="1.0" encoding="utf-8"?>
<!-- One picture (drawn by MiniGames) with a 4 x 4 grid of invisible tap squares on top of it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/sm_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/mini_desc" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/sm_t0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/sm_t4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/sm_t8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <ImageView android:id="@+id/sm_t12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
            <ImageView android:id="@+id/sm_t15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
